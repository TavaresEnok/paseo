#!/usr/bin/env python3
"""Paseo ACP launcher; also supports the provider's --version diagnostic."""
import importlib.util
import os
from pathlib import Path
import sys

wrapper = os.environ.get('PASEO_GROK_ISOLATED', '/home/enok/.local/share/paseo-orchestrator/native/isolated-provider.py')
admission = Path(__file__).resolve().parent / 'isolated-provider.py'
spec = importlib.util.spec_from_file_location('paseo_grok_admission', admission)
if spec is None or spec.loader is None:
    raise SystemExit('Admissão Grok indisponível.')
module = importlib.util.module_from_spec(spec)
spec.loader.exec_module(module)
if 'agent' in sys.argv[1:] and not os.environ.get('PASEO_AGENT_ID'):
    from runpy import run_path
    run_path(str(Path(__file__).with_name('grok-metadata.py')),run_name='__main__')
    raise SystemExit(0)
argv = module.apply_grok_admission(sys.argv[1:])
os.execv(wrapper, [wrapper, 'grok', *argv])
